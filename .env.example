# Copy to .env and fill in. .env is gitignored and must never be committed.

# =====================================================================
# LLM PROVIDERS - free tiers, no credit card required
# =====================================================================
# The system is provider-agnostic (spec section 5). Any OpenAI-compatible
# endpoint works; these are the ones with usable free tiers.
#
# The two that matter - Channel A and Channel B, on DIFFERENT VENDORS (D21):
#   Groq    -> https://console.groq.com  OBSERVED 30 req/min, 14,400 req/day
#   NVIDIA  -> https://build.nvidia.com  OBSERVED >=20 req/min; DAILY LIMIT
#              UNOBSERVED (no rate-limit headers). Sheds load with HTTP 503
#              under contention, not 429 under quota, and its latency swings
#              0.4s-12.5s on identical prompts - so latency measured on this
#              provider must never be reported as a property of the method.
#
# Optional:
#   Gemini  -> https://aistudio.google.com  OBSERVED 20 req/day - NOT the 1,500
#              its documentation implies (RX-006). Too thin to run an arm on.
#   OpenRouter -> ~50 req/day at a zero balance. A third opinion, not an engine.
#
# Every figure above that says OBSERVED came from a live call or a live refusal.
# Published limits have been wrong here by 75x, so re-check with
# scripts/verify_llm_providers.py rather than trusting a vendor's docs.

GROQ_API_KEY=
NVIDIA_API_KEY=

GEMINI_API_KEY=
OPENROUTER_API_KEY=

# =====================================================================
# CHANNEL BINDINGS (decision D1: dual-channel independence)
# =====================================================================
# Format: provider/model. Provider and model live in one variable so a binding
# cannot be half-changed.
#
# The two reasoning channels are bound to DIFFERENT MODELS FROM DIFFERENT LABS.
# What makes channel disagreement informative rather than a measure of sampling
# noise is different training data, different architectures and different
# failure modes - not the hostname the request goes to.
#
# Cross-VENDOR binding (Channel A and Channel B on separate providers) is
# stronger still, and was the default until D44. See the D44 block below for
# why it was traded away and what that costs.
#
# Verify model ids before relying on them: free providers rotate their lineups.
#   .venv/Scripts/python scripts/verify_llm_providers.py --list

# D21 (ACTIVE since 2026-08-29, RX-014): genuinely CROSS-VENDOR. Channel A runs
# on Groq, Channel B on NVIDIA NIM - different vendor, different serving stack,
# different lab, different model family. This supersedes D20's cross-lab
# arrangement, which parked both channels on Groq after Gemini enforced 20/day.
#
# Note the doubled prefix: the binding is provider/model, and NVIDIA's model ids
# themselves contain a slash. `nvidia/` + `nvidia/nemotron-3-ultra-550b-a55b`.
#
# Same-MODEL bindings are refused by scripts/run_slice.py. Model ids rotate:
# confirm with scripts/verify_llm_providers.py --list.
# D44 (ACTIVE since 2026-09-01): both channels now run on NVIDIA, bound to two
# models from two different labs - OpenAI's gpt-oss-120b and NVIDIA's Nemotron-3.
# Groq's 200,000 tokens/day was the campaign's binding constraint: eight days for
# four arms, and the B1/B2/B4 baselines could not run at all, because a baseline
# must share arm A's natural model. NVIDIA has no observed daily token cap and the
# six-arm campaign costs 720 requests, so it finishes in a day.
#
# What this costs: a 503 on NVIDIA's shared endpoint now fails BOTH channels at
# once, and any edge transformation NVIDIA applies reaches both. That second one
# is unmeasured and is the real limitation. `channels_are_independent()` reports
# "same provider, different models" and config.json records it per run, so no
# artifact inherits a stronger claim than the binding that produced it.
#
# To restore cross-vendor binding, set NATURAL_CHANNEL_MODEL back to a groq/ id.
NATURAL_CHANNEL_MODEL=nvidia/openai/gpt-oss-120b
PROGRAM_CHANNEL_MODEL=nvidia/nvidia/nemotron-3-ultra-550b-a55b
VERIFICATION_AGENT_MODEL=nvidia/openai/gpt-oss-120b
QUESTION_UNDERSTANDING_MODEL=groq/openai/gpt-oss-20b

# Ablation arm H (hypothesis H4) puts both channels on the SAME model, to test
# whether vendor/model diversity contributes anything beyond prompt and modality
# difference. It is NOT configured here.
#
# There was an ABLATION_SAME_MODEL variable in this file for weeks and nothing
# read it. Wiring it up would have been the wrong repair: arms are ArmConfig
# objects over one graph (D26), `same_model_both_channels` lives there, and a
# second source of truth in the environment could disagree with the arm actually
# running - so the run record would name one configuration while the code
# executed another. Arm H selects the model from the arm, not from here.

# =====================================================================
# DECODING (spec section 18 - reproducibility)
# =====================================================================
# Unlike the frontier hosted models, these open/free models DO accept
# temperature, so runs can be pinned at 0. See decision D7.
# All four are read at CALL time by backend/services/llm/settings.py.
# They sat here unread until 2026-08-30: every call used whatever default
# its own function signature carried, so LLM_MAX_TOKENS=4096 lost to
# Channel A's 2048 and truncated a reasoning model mid-thought on 35% of
# questions (RX-019). A setting nothing reads is worse than no setting.
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096
LLM_MAX_RETRIES=5
LLM_TIMEOUT_SECONDS=120

# =====================================================================
# EMBEDDINGS (decision D2: local, no embedding API dependency)
# =====================================================================
# Chosen by measurement, not preference - see D2a / EXPERIMENTS.md RX-003.
EMBEDDING_MODEL=intfloat/e5-base-v2
EMBEDDING_DEVICE=cpu

# Cross-encoder reranking over the fused candidate pool. UNSET on purpose, and
# unset is the measured position rather than an untried default: RX-035 ran
# cross-encoder/ms-marco-MiniLM-L-6-v2 over the same 100 evidence groups as
# RX-034 and it scored 0.240 against a 0.280 baseline - worse. Setting this
# changes what evidence BOTH channels see, so a run with it on and a run with it
# off are different systems sharing a config id. Leave it empty unless you are
# deliberately measuring a candidate, and record which one in the run.
#   .\.venv\Scripts\python.exe scripts\measure_reranking.py --gold <gold.json>
RERANK_MODEL=

# =====================================================================
# SERVICES (docker-compose.yml)
# =====================================================================
POSTGRES_USER=finverify
POSTGRES_PASSWORD=finverify_dev
POSTGRES_DB=finverify
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://finverify:finverify_dev@localhost:5433/finverify

QDRANT_PORT=6333
QDRANT_URL=http://localhost:6333
# MUST match the model above. A collection is built by one embedding model and
# is only meaningful to that model. BGE-base and E5-base are both 768-dim, so
# Qdrant accepts either against either and returns ranked, confident, wrong
# results - it cannot tell them apart, and neither can a dimension check.
# `finverify_chunks` is the superseded BGE index kept for RX-001..RX-003;
# `finverify_e5` is the current corpus. Pairing this with the wrong model is
# what D-1 was. `backend/rag/manifest.py` now refuses to run on a mismatch.
QDRANT_COLLECTION=finverify_e5

# =====================================================================
# SANDBOX (spec section 37)
# =====================================================================
SANDBOX_IMAGE=python:3.12-slim
SANDBOX_TIMEOUT_SECONDS=10
SANDBOX_MEMORY_LIMIT=256m
SANDBOX_CPU_LIMIT=1.0

# =====================================================================
# API
# =====================================================================
# Where POST /documents/upload stores a registered PDF. Read per REQUEST, not
# at import, so a test fixture can redirect it - a module-level default is
# evaluated before any fixture runs, which is how the API's own tests came to
# write into documents/raw/ beside five real annual reports.
# FINVERIFY_UPLOAD_DIR=documents/raw

# Stamped into the image at build time (docker/api.Dockerfile --build-arg) and
# echoed by GET /health. Without it a container running week-old code reports
# "status: ok" exactly like one running current code, and nothing in the
# response can tell them apart.
# FINVERIFY_BUILD_REF=dev
